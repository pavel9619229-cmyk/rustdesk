[Unit]
Description=Masha Session Authorization Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/masha-auth
EnvironmentFile=-/etc/masha-auth/masha-auth.env
ExecStart=/usr/bin/python3 /opt/masha-auth/masha_auth.py serve
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/masha-auth

[Install]
WantedBy=multi-user.target
